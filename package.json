{
  "name": "@sooth/sdk",
  "version": "0.2.1",
  "packageManager": "pnpm@9.15.9",
  "description": "Sooth Protocol SDK — programmatic access, core utilities, and CLI for prediction markets",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "soothcli": "./bin/soothcli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core/utils": {
      "types": "./dist/core/utils.d.ts",
      "import": "./dist/core/utils.js"
    },
    "./core/types": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.js"
    },
    "./core/errors": {
      "types": "./dist/core/errors.d.ts",
      "import": "./dist/core/errors.js"
    },
    "./core/abis": {
      "types": "./dist/core/abis/index.d.ts",
      "import": "./dist/core/abis/index.js"
    },
    "./core/math": {
      "types": "./dist/core/math/index.d.ts",
      "import": "./dist/core/math/index.js"
    },
    "./core/config": {
      "types": "./dist/core/config/index.d.ts",
      "import": "./dist/core/config/index.js"
    },
    "./core/contracts": {
      "types": "./dist/core/contracts/index.d.ts",
      "import": "./dist/core/contracts/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "src/cli"
  ],
  "scripts": {
    "build": "tsc && chmod +x bin/soothcli.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "interactive": "bun run src/cli/interactive.ts",
    "lint": "eslint 'src/**/*.ts'",
    "lint:check": "eslint 'src/**/*.ts'",
    "fmt": "prettier --write 'src/**/*.ts'",
    "fmt:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint:check && pnpm fmt:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint",
      "prettier --check"
    ]
  },
  "dependencies": {
    "viem": "^2.21.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^20.0.0",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.1"
  }
}
