{
  "name": "sooth",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Protocol-neutral Sooth Question Format (SQF) parser and generator",
  "keywords": [
    "sooth",
    "sqf",
    "question-format",
    "parser"
  ],
  "license": "MIT",
  "contributors": [
    {
      "name": "zakrad",
      "url": "https://github.com/zakrad"
    },
    {
      "name": "daniel",
      "email": "daniel@tora.build"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tora-Build/sooth-sdk.git"
  },
  "homepage": "https://github.com/Tora-Build/sooth-sdk#readme",
  "bugs": {
    "url": "https://github.com/Tora-Build/sooth-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqf": {
      "types": "./dist/lib/sqf.d.ts",
      "import": "./dist/lib/sqf.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint 'src/**/*.ts'",
    "lint:check": "eslint 'src/**/*.ts'",
    "fmt": "prettier --write 'src/**/*.ts'",
    "fmt:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint:check && pnpm fmt:check",
    "prepare": "husky || true",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:package": "node scripts/check-package.mjs"
  },
  "lint-staged": {
    "*.ts": [
      "eslint",
      "prettier --check"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^20.0.0",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^2.1.0"
  }
}
