{
  "name": "sooth-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter ./apps/web dev",
    "dev:all": "pnpm run --parallel dev:web dev:indexer",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:indexer": "pnpm --filter ./packages/indexer dev",
    "start:all": "./start-all.sh",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:contracts": "pnpm --filter contracts-testing test",
    "deploy:contracts": "pnpm --filter contracts-core deploy",
    "benchmark": "pnpm --filter contracts-testing benchmark"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
