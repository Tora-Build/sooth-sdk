{
  "name": "sooth",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Sooth Factory protocol SDK, embeddable market UI, CLI and SQF utilities",
  "keywords": [
    "sooth",
    "sqf",
    "question-format",
    "prediction-markets",
    "ethereum"
  ],
  "license": "MIT",
  "contributors": [
    {
      "name": "zakrad",
      "url": "https://github.com/zakrad"
    },
    {
      "name": "daniel",
      "email": "daniel@tora.build"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tora-Build/sooth-sdk.git"
  },
  "homepage": "https://github.com/Tora-Build/sooth-sdk#readme",
  "bugs": {
    "url": "https://github.com/Tora-Build/sooth-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqf": {
      "types": "./dist/lib/sqf.d.ts",
      "import": "./dist/lib/sqf.js"
    },
    "./factory": {
      "types": "./dist/factory/index.d.ts",
      "import": "./dist/factory/index.js"
    },
    "./factory/factoryAbi": {
      "types": "./dist/factory/factoryAbi/index.d.ts",
      "import": "./dist/factory/factoryAbi/index.js"
    },
    "./factory/abis": {
      "types": "./dist/factory/factoryAbi/index.d.ts",
      "import": "./dist/factory/factoryAbi/index.js"
    },
    "./factory/data": {
      "types": "./dist/factory/data.d.ts",
      "import": "./dist/factory/data.js"
    },
    "./factory/*": {
      "types": "./dist/factory/*.d.ts",
      "import": "./dist/factory/*.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/factoryHooks": {
      "types": "./dist/react/factoryHooks.d.ts",
      "import": "./dist/react/factoryHooks.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "skills"
  ],
  "bin": {
    "soothcli": "./bin/soothcli.js"
  },
  "scripts": {
    "build": "pnpm clean && tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:check": "eslint 'src/**/*.{ts,tsx}'",
    "fmt": "prettier --write 'src/**/*.{ts,tsx}'",
    "fmt:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint:check && pnpm fmt:check",
    "prepare": "husky || true",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:package": "node scripts/check-package.mjs"
  },
  "lint-staged": {
    "*.ts": [
      "eslint",
      "prettier --check"
    ]
  },
  "dependencies": {
    "viem": "^2.45.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@tanstack/react-query": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "@tanstack/react-query": { "optional": true }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "postcss@>=8.0.0 <8.5.23": "8.5.23",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "minimatch@>=10.0.0 <11.0.1": "11.0.3"
    }
  }
}
