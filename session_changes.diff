-    error UnauthorizedRegistrar();
-    error OrderNotActive();
-    error NoLiquidity();
-    error SlippageExceeded();
-    error LiquidityOverflow();
-    error FeeTooHigh();
-
-    // ============================================
-    // Types
-    // ============================================
-
-    struct Market {
-        address truthMarket;
