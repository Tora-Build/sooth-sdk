-            if (pendingShares > maxFillable) {
-                pendingShares = maxFillable;
-            }
-        }
-
-        uint256 globalUsedGrowth = _collateralUsedGrowthGlobalX128[marketKey][out];
-        uint256 lastUsedGrowth = _collateralUsedGrowthLastX128[marketKey][orderId];
