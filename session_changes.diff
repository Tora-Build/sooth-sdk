-        // After cross hook
-        if (m.hook != address(0) && m.hook.afterCross()) {
-            ITickBookHooks.CrossParams memory params = ITickBookHooks.CrossParams({
-                marketKey: marketKey,
-                newOrderId: newOrderId,
-                crossedShares: crossedShares,
-                crossTick: crossTick
