-            oppositeCost = yesCost;
-        } else {
-            // BUY YES: buyer pays YES cost, seller gets NO proceeds
-            newOrderCost = yesCost;
-            oppositeCost = noCost;
-        }
-
-        // Credit shares to new order owner
