\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"All execution venues query this contract for market state Lifecycle: CREATED \\u2192 LIVE \\u2192 SETTLING \\u2192 SETTLED \\u2192 FINALIZED   - CREATED: Market created but not activated   - LIVE: Trading active (before deadline)   - SETTLING: Deadline passed, awaiting adjudicator resolution   - SETTLED: Outcome determined, guardian can veto   - FINALIZED: Settlement locked, redemption enabled\",\"kind\":\"dev\",\"methods\":{\"activate()\":{\"details\":\"Only creator can activate\"},\"getRedemptionValue(uint8)\":{\"details\":\"For binary markets: returns 1e18 for winning outcome, 0 for losing      For INVALID markets: may return fractional values\",\"params\":{\"outcome\":\"Outcome index (0=NO, 1=YES)\"},\"returns\":{\"_0\":\"Redemption value in WAD (1e18 = 1 USDC)\"}},\"isFinalized()\":{\"returns\":{\"_0\":\"True if market is finalized\"}},\"isLive()\":{\"details\":\"Market is live if in LIVE state AND before deadline.      After deadline, trading should stop even if settle() hasn't been called yet.\",\"returns\":{\"_0\":\"True if trading is allowed\"}},\"isSettled()\":{\"details\":\"Returns true if adjudicator has finalized the outcome\",\"returns\":{\"_0\":\"True if market is settled\"}},\"isSettling()\":{\"returns\":{\"_0\":\"True if market is in settling period\"}},\"settle(uint8,uint64)\":{\"params\":{\"_tStar\":\"Retroactive truth-time (0 if not applicable)\",\"outcome\":\"Winning outcome (0=NO, 1=YES, 2=INVALID)\"}},\"veto()\":{\"details\":\"Reverts market to SETTLING state for re-adjudication\"}},\"stateVariables\":{\"creator\":{\"return\":\"Address of market creator\",\"returns\":{\"_0\":\"Address of market creator\"}},\"deadline\":{\"return\":\"Unix timestamp of market deadline\",\"returns\":{\"_0\":\"Unix timestamp of market deadline\"}},\"question\":{\"return\":\"Market question string\",\"returns\":{\"_0\":\"Market question string\"}},\"tStar\":{\"details\":\"Returns the timestamp when the outcome became true.      Returns 0 if no retroactive settlement applies.\",\"return\":\"Unix timestamp of truth-time\",\"returns\":{\"_0\":\"Unix timestamp of truth-time\"}},\"winningOutcome\":{\"details\":\"0 = NO, 1 = YES, 2 = INVALID\",\"return\":\"Winning outcome index\",\"returns\":{\"_0\":\"Winning outcome index\"}}},\"title\":\"TruthMarket\",\"version\":1},\"userdoc\":{\"events\":{\"MarketActivated(address,uint256)\":{\"notice\":\"Emitted when market is activated for trading\"}},\"kind\":\"user\",\"methods\":{\"activate()\":{\"notice\":\"Activate market for trading\"},\"creator()\":{\"notice\":\"Get market creator\"},\"deadline()\":{\"notice\":\"Get market deadline\"},\"finalize()\":{\"notice\":\"Finalize settlement (irreversible)\"},\"getRedemptionValue(uint8)\":{\"notice\":\"Get redemption value per token (WAD precision)\"},\"isFinalized()\":{\"notice\":\"Check if market is fully finalized (irreversible)\"},\"isLive()\":{\"notice\":\"Check if market is accepting trades\"},\"isSettled()\":{\"notice\":\"Check if market has been settled\"},\"isSettling()\":{\"notice\":\"Check if market is awaiting settlement (past deadline, not yet settled)\"},\"question()\":{\"notice\":\"Get market question\"},\"settle(uint8,uint64)\":{\"notice\":\"Settle market with outcome\"},\"tStar()\":{\"notice\":\"Get retroactive truth-time (T*)\"},\"veto()\":{\"notice\":\"Guardian veto (emergency only)\"},\"winningOutcome()\":{\"notice\":\"Get winning outcome\"}},\"notice\":\"Canonical source of truth for market lifecycle and settlement\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/TruthMarket.sol\":\"TruthMarket\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":1},\"remappings\":[\":@openzeppelin/contracts-upgradeable/=lib/openzeppelin-contracts-upgradeable/contracts/\",\":@openzeppelin/contracts/=lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/con