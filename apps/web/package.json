{
  "name": "sooth-demo-ui-v2",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "validate-config": "node scripts/validate-config.js",
    "sync-deployments": "node scripts/sync-deployments.js",
    "dev": "npm run validate-config && vite",
    "build": "pnpm --filter @sooth/sdk-core build && npm run validate-config && vite build",
    "preview": "npm run validate-config && vite preview",
    "export": "npm run build && bash scripts/export-static.sh",
    "serve": "node server.js",
    "test:e2e:cache": "synpress",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:basic": "playwright test --project=basic",
    "test:e2e:wallet": "playwright test --project=wallet",
    "test:e2e:onchain": "playwright test --project=onchain"
  },
  "dependencies": {
    "@sooth/sdk-core": "workspace:*",
    "express": "^4.21.0",
    "http-proxy-middleware": "^3.0.3",
    "@reown/appkit": "^1.8.14",
    "@reown/appkit-adapter-wagmi": "^1.8.14",
    "@tanstack/react-query": "^5.51.11",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.424.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.10.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.18.8",
    "wagmi": "^2.12.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@synthetixio/synpress": "^3.7.3",
    "@types/node": "^20.19.26",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^7.3.0",
    "vite-plugin-checker": "^0.12.0"
  }
}