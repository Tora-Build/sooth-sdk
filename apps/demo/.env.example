# ==============================================
# Sooth Protocol - Environment Configuration
# ==============================================
# This file supports both local development and E2E testing.
# Copy to .env and fill in the relevant sections.
# NEVER commit .env to git!

# ==============================================
# DEVELOPMENT - Deployment Scripts
# ==============================================
# Private key for deploying contracts (with 0x prefix)
# Use a test wallet - NEVER use a wallet with real funds!
PRIVATE_KEY=0x...

# Optional: WalletConnect Project ID for better wallet support
# Get one at https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=

# ==============================================
# E2E TESTING - Synpress/Playwright
# ==============================================
# These are only needed for running e2e tests with Synpress

# Password for MetaMask (Synpress will use this to unlock the wallet)
WALLET_PASSWORD=YourSecurePassword123

# 12-word seed phrase for your TEST wallet (comma or space separated)
# WARNING: Use a dedicated test wallet - NEVER use a wallet with real funds!
SECRET_WORDS=word1,word2,word3,word4,word5,word6,word7,word8,word9,word10,word11,word12

# Optional: Override the base URL for e2e tests
# E2E_BASE_URL=http://127.0.0.1:5173
