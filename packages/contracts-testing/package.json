{
  "name": "contracts-testing",
  "version": "9.9.6",
  "private": true,
  "type": "module",
  "description": "Sooth Protocol V9.9.6 Testing, Market Operations & Partner Demos",
  "scripts": {
    "test": "forge test",
    "test:unit": "forge test --match-path 'test/v9/*.t.sol'",
    "test:fuzz": "forge test --match-contract Fuzz",
    "test:invariant": "forge test --match-contract Invariants",
    "test:fork": "forge test --match-path 'test/v9/fork/*.t.sol'",
    "benchmark": "bun run script/benchmark/hft-benchmark.ts",
    "benchmark:base": "bun run script/benchmark/hft-benchmark.ts --chain=baseSepolia",
    "benchmark:monad": "bun run script/benchmark/hft-benchmark.ts --chain=monadTestnet",
    "graduate": "bun run script/markets/graduate-market.ts",
    "interactive": "bun run script/interactive/interactive-test.ts",
    "interactive:base": "bun run script/interactive/interactive-test.ts --chain=baseSepolia",
    "interactive:monad": "bun run script/interactive/interactive-test.ts --chain=monadTestnet"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
