{
  "name": "contracts-evm",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "description": "Sooth Protocol V8 EVM Contracts",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "deploy": "bun run script/deploy-multichain.ts",
