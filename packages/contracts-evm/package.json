    "deploy:monad": "bun run script/deploy-multichain.ts --chains=monadTestnet",
    "deploy:all": "bun run script/deploy-multichain.ts",
    "benchmark": "bun run script/hft-benchmark.ts",
    "benchmark:base": "bun run script/hft-benchmark.ts --chain=baseSepolia",
    "benchmark:megaeth": "bun run script/hft-benchmark.ts --chain=megaethFrontier",
    "benchmark:monad": "bun run script/hft-benchmark.ts --chain=monadTestnet"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
