# ==============================================
# Sooth Protocol - Contract Deployment Config
# ==============================================
# Copy to .env and fill in values.
# NEVER commit .env to git!

# ==============================================
# REQUIRED - Deployment Private Key
# ==============================================
# Private key for deploying contracts (with 0x prefix)
# Use a test wallet with testnet funds only!
PRIVATE_KEY=0x...

# ==============================================
# OPTIONAL - RPC Overrides
# ==============================================
# Override default RPC endpoints (see chainConfigs.ts for defaults)
# BASE_SEPOLIA_RPC=https://sepolia.base.org
# MEGAETH_RPC=https://carrot.megaeth.com/rpc
# MONAD_RPC=https://testnet-rpc.monad.xyz

# ==============================================
# OPTIONAL - Etherscan API Keys (for verification)
# ==============================================
# ETHERSCAN_API_KEY=
# BASESCAN_API_KEY=
