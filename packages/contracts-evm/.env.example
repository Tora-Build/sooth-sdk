# Foundry Deployment Configuration
# Copy to .env and fill in PRIVATE_KEY

# === REQUIRED ===
PRIVATE_KEY=0x_PASTE_YOUR_PRIVATE_KEY_HERE

# === Base Sepolia (V4.6 Lock-on-Sell) ===
RPC_URL=https://sepolia.base.org

# === Other Networks ===
MONAD_RPC_URL=https://testnet.monad.xyz
BNB_RPC_URL=https://bsc-testnet-rpc.publicnode.com
MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc

# Frontend Path (relative to this repo)
FRONTEND_PATH=../../apps/web
