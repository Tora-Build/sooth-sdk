-export default crypto;
+// React Native compatible version - lazy evaluation
+let _crypto;
+function getCrypto() {
+  if (!_crypto) {
+    _crypto = globalThis.crypto || global.crypto;
+    if (!_crypto) {
+      throw new Error('crypto is not available. Make sure react-native-quick-crypto is installed and initialized.');
+    }
+  }
+  return _crypto;
+}
+
+export default new Proxy({}, {
+  get(target, prop) {
+    return getCrypto()[prop];
+  },
+  has(target, prop) {
+    return prop in getCrypto();
+  }
+});
+
 export const isCryptoKey = (key) => key instanceof CryptoKey;
