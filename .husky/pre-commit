#!/bin/sh
# .husky/pre-commit
# Enforces deployment verification when config files are staged

# Check if deployment-related files are being committed
if git diff --cached --name-only | grep -qE 'deployments\.json|markets\.json'; then
    echo "🔍 Deployment config changed - running verification..."
    
    # Run verification script
    if [ -f "packages/contracts-evm/script/verify-deployment.sh" ]; then
        cd packages/contracts-evm
        ./script/verify-deployment.sh
        RESULT=$?
        cd - > /dev/null
        
        if [ $RESULT -ne 0 ]; then
            echo ""
            echo "❌ COMMIT BLOCKED: Deployment verification failed!"
            echo "   Fix the issues above or run './script/verify-deployment.sh' for details."
            exit 1
        fi
        echo "✅ Deployment verification passed"
    else
        echo "⚠️  Warning: verify-deployment.sh not found, skipping verification"
    fi
fi

# Check if version was bumped when deployments.json changed
if git diff --cached --name-only | grep -q 'deployments\.json'; then
    # Check if version field was modified
    VERSION_CHANGED=$(git diff --cached apps/web/src/config/deployments.json | grep -c '"version"')
    if [ "$VERSION_CHANGED" -eq 0 ]; then
        echo ""
        echo "⚠️  WARNING: deployments.json changed but version was not bumped!"
        echo "   Consider updating the 'version' field to trigger browser cache refresh."
        echo ""
        # Don't block, just warn
    fi
fi

exit 0
